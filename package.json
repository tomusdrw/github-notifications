{
  "name": "github-notifications-feed",
  "version": "0.1.0",
  "description": "Poll GitHub notifications, hydrate content, append to a local JSONL feed file",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "gh-notifications": "dist/index.js"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "commander": "^15.1.0",
    "octokit": "^5.0.5",
    "pino": "^10.4.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
